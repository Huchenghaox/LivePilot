{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "livepilot-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-25",
  "workers_dev": true,
  "vars": {
    "APP_ENV": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "livepilot-production",
      "database_id": "1d503efc-6f49-460c-acf7-ac5801f1e813"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "livepilot-uploads"
    }
  ]
}
