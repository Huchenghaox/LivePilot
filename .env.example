# LivePilot local development example
# Copy to .env only for local use. Do not commit real secrets.

# Use production on the server. Development can keep development.
APP_ENV=development
APP_NAME=LivePilot
PUBLIC_SITE_URL=http://127.0.0.1:3000
DATABASE_URL=sqlite:///./data/live_assistant.db
# Production must set a unique 32+ character secret.
JWT_SECRET=dev-secret-change-me
# closed | invite | open. Production should use invite until SMS is fully verified.
REGISTRATION_MODE=invite
INVITE_CODE=BETA2026
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
UPLOAD_DIR=./data/uploads

# Browser-facing API URL. On production use something like:
# NEXT_PUBLIC_API_BASE_URL=https://api.haoxagent.com
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# SMS verification. Development can use SMS_PROVIDER=mock.
# Production must configure a real provider before open registration.
SMS_ENABLED=false
SMS_PROVIDER=mock
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_REGION=
SMS_CODE_TTL_SECONDS=300
SMS_SEND_INTERVAL_SECONDS=60
SMS_HOURLY_LIMIT_PER_PHONE=5
SMS_DAILY_LIMIT_PER_PHONE=10
SMS_HOURLY_LIMIT_PER_IP=30
VERIFICATION_MAX_ATTEMPTS=5
LOGIN_FAIL_HOURLY_LIMIT=10
REGISTER_HOURLY_LIMIT_PER_IP=20

# Platform model defaults. Leave empty unless you operate a shared model gateway.
PLATFORM_TEXT_API_BASE=
PLATFORM_TEXT_API_KEY=
PLATFORM_TEXT_MODEL=
PLATFORM_VISION_API_BASE=
PLATFORM_VISION_API_KEY=
PLATFORM_VISION_MODEL=

# Douyin official OAuth placeholders. Do not commit real values.
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=
DOUYIN_PLATFORM_STATUS=未配置

# Comma-separated phones that can manage public rules and view feedback.
ADMIN_PHONES=
